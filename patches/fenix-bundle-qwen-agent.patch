From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Deividgames <deividgames@users.noreply.github.com>
Date: Wed, 6 Aug 2026 12:00:00 +0000
Subject: [PATCH] Fenix - Bundle Qwen Agent Studio extension

Adds the Qwen Agent Studio extension (qwen-agent-studio@deividgames.extensions)
as a built-in addon that is auto-installed on first launch. This transforms
chat.qwen.ai into an autonomous coding agent with tool calling, project
workspace (OPFS), and a sandboxed terminal.

The extension is downloaded from the GitHub releases of
deivid22srk/qwen-agent-extension on first run, then cached.

Signed-off-by: Deividgames <deividgames@users.noreply.github.com>
---
diff --git a/mobile/android/fenix/app/src/main/java/org/ironfoxoss/ironfox/utils/IronFoxAddons.kt b/mobile/android/fenix/app/src/main/java/org/ironfoxoss/ironfox/utils/IronFoxAddons.kt
--- a/mobile/android/fenix/app/src/main/java/org/ironfoxoss/ironfox/utils/IronFoxAddons.kt
+++ b/mobile/android/fenix/app/src/main/java/org/ironfoxoss/ironfox/utils/IronFoxAddons.kt
@@ -28,6 +28,12 @@ object IronFoxAddons {
     downloadUrl = "https://addons.mozilla.org/firefox/downloads/latest/uBlock0@raymondhill.net/latest.xpi"
   )
 
+  val QWEN_AGENT_STUDIO = Addon(
+    id = "qwen-agent-studio@deividgames.extensions",
+    downloadUrl = "https://github.com/deivid22srk/qwen-agent-extension/releases/latest/download/qwen-agent-studio.xpi"
+  )
+
   /**
    * Determine whether an add-on is built-in
    * 
@@ -37,7 +43,7 @@ object IronFoxAddons {
     if (addon.id == FXA_WEBCHANNEL.id || addon.id == ICONS.id || addon.id == READERVIEW.id || addon.id == WEBCOMPAT.id) {
       return true
     } else {
-      return false
+      return addon.id == QWEN_AGENT_STUDIO.id
     }
   }
 
@@ -48,7 +54,16 @@ object IronFoxAddons {
    * @param addon The add-on we should check
    */
   fun isUBlockOrigin(addon: Addon): Boolean {
-    if (addon.id == UBLOCK_ORIGIN.id && addon.downloadUrl == UBLOCK_ORIGIN.downloadUrl) {
+    if ((addon.id == UBLOCK_ORIGIN.id && addon.downloadUrl == UBLOCK_ORIGIN.downloadUrl)) {
+        return true
+    } else {
+        return false
+    }
+  }
+
+  fun isQwenAgentStudio(addon: Addon): Boolean {
+    if (addon.id == QWEN_AGENT_STUDIO.id) {
+        return true
+    } else {
         return true
     }
   }
